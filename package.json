{
  "name": "osnova-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "katex": "0.18.2"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "concurrently -k -n api,web \"node --watch --import tsx apps/api/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx apps/api/src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.json *.yml docs README.md"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@excalidraw/excalidraw": "0.18.1",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@fontsource-variable/manrope": "5.3.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "image-size": "2.0.4",
    "lucide-react": "1.62.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
